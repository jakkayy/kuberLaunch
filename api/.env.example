PORT=8080
ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=kuberlauncher
DB_PASSWORD=kuberlauncher
DB_NAME=kuberlauncher
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your_github_username
ARGOCD_URL=http://argocd.localhost:8090
ARGOCD_USERNAME=admin
ARGOCD_PASSWORD=your_argocd_password
GRAFANA_URL=http://grafana.localhost:8090
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin
GRAFANA_PUBLIC_URL=
VAULT_URL=http://vault.localhost:8090
# Local dev: VAULT_AUTH_METHOD=token with the dev root token.
# In-cluster: VAULT_AUTH_METHOD=kubernetes (see scripts/setup-vault.sh).
VAULT_AUTH_METHOD=token
VAULT_TOKEN=root
VAULT_CLUSTER_URL=http://vault.vault.svc.cluster.local:8200
VAULT_K8S_ROLE=kuberlaunch-api
AUTH_JWT_SECRET=dev-only-change-me-0123456789abcdef
PLATFORM_ADMINS=
# GitHub App (preferred over GITHUB_TOKEN). Install it on GITHUB_OWNER (an org) with
# permissions: Administration, Contents, Workflows, Actions (read/write), Metadata (read).
GITHUB_OWNER_IS_ORG=false
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# API token of the least-privilege "kuberlaunch" ArgoCD account (k8s/platform/argocd-account.yaml):
#   argocd account generate-token --account kuberlaunch
ARGOCD_TOKEN=
# Any secret above can instead be read from a file: set <NAME>_FILE (e.g. DB_PASSWORD_FILE).
