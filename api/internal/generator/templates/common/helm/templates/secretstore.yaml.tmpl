{{- "{{" }}- if .Values.externalSecret.enabled {{ "}}" }}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ "{{" }} .Values.externalSecret.vault.serviceAccount {{ "}}" }}
  namespace: {{ "{{" }} .Release.Namespace {{ "}}" }}
---
apiVersion: external-secrets.io/v1beta1
kind: SecretStore
metadata:
  name: {{ "{{" }} .Release.Name {{ "}}" }}-vault
  namespace: {{ "{{" }} .Release.Namespace {{ "}}" }}
spec:
  provider:
    vault:
      server: {{ "{{" }} .Values.externalSecret.vault.server | quote {{ "}}" }}
      path: secret
      version: v2
      auth:
        kubernetes:
          mountPath: {{ "{{" }} .Values.externalSecret.vault.authMount | quote {{ "}}" }}
          role: {{ "{{" }} .Values.externalSecret.vault.role | quote {{ "}}" }}
          serviceAccountRef:
            name: {{ "{{" }} .Values.externalSecret.vault.serviceAccount {{ "}}" }}
{{- "{{" }}- end {{ "}}" }}
