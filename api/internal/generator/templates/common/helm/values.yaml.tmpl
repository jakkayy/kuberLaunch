replicaCount: 1

image:
  repository: ghcr.io/{{ .Owner }}/{{ .Slug }}
  pullPolicy: Always
  tag: "latest"
  pullSecret: "ghcr-secret"

service:
  type: ClusterIP
  port: {{ .Port }}

ingress:
  enabled: true
  className: nginx
  host: {{ .Slug }}.local

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 256Mi

env: []

# Secrets are read from Vault path secret/kuberlauncher/{{ .Slug }} by External
# Secrets, authenticating as a dedicated service account (Vault Kubernetes auth)
# that can read only this project's path.
externalSecret:
  enabled: true
  refreshInterval: 1m
  vault:
    server: {{ .VaultServer }}
    authMount: {{ .VaultAuthMount }}
    role: {{ .VaultRole }}
    serviceAccount: {{ .VaultSA }}
