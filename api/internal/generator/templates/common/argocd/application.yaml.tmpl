apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ .EnvApp }}
  namespace: argocd
spec:
  project: {{ .Slug }}
  source:
    repoURL: https://github.com/{{ .Owner }}/{{ .Slug }}
    targetRevision: HEAD
    path: helm
    helm:
      releaseName: {{ .Slug }}
      valueFiles:
        - values.yaml
        - values-{{ .Env }}.yaml
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ .EnvNamespace }}
  syncPolicy:
{{- if .AutoSync }}
    automated:
      prune: true
      selfHeal: true
{{- end }}
    syncOptions:
      - CreateNamespace=true
