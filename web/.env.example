API_URL=http://localhost:8080

# Shared with the Go API (api/.env AUTH_JWT_SECRET). At least 32 characters.
AUTH_JWT_SECRET=dev-only-change-me-0123456789abcdef

# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Callback URL: http://localhost:3000/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Only members of this GitHub org may sign in (optional).
AUTH_ALLOWED_ORG=

# Development only: skip GitHub and sign in as this login. Ignored in production.
AUTH_DEV_LOGIN=
